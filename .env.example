# ───────────────────────────────────────────
# NextGen IT Hub — Environment Variables
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to version control.
# ───────────────────────────────────────────

# ── App ──────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="NextGen IT Hub"
NEXT_PUBLIC_COMPANY_EMAIL=info@nextgenithub.in
NEXT_PUBLIC_COMPANY_PHONE=+919876543210

# ── Database ──────────────────────────────────
# Pooled connection (via PgBouncer / Supabase Pooler)
DATABASE_URL=postgresql://postgres:password@localhost:5432/nextgen_it_hub

# Direct connection (for migrations / Prisma Studio)
DIRECT_URL=postgresql://postgres:password@localhost:5432/nextgen_it_hub

# ── Encryption ────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_key_here

# HMAC secret for phone number lookup hashes
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HASH_SECRET=your_hash_secret_here

# ── Auth / JWT ────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# JWT signing secret for custom tokens (video call tokens, etc.)
JWT_SECRET=your_jwt_secret_here

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Razorpay ──────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Public (browser-safe)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# ── LiveKit ───────────────────────────────────
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_WS_URL=wss://your-project.livekit.cloud

# Public for client-side LiveKit components
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# ── WhatsApp Business API ─────────────────────
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token

# ── Email (Resend) ────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="NextGen IT Hub <noreply@nextgenithub.in>"
EMAIL_REPLY_TO=support@nextgenithub.in

# ── Cloudinary ────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# ── Sentry ────────────────────────────────────
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=nextgen-it-hub
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project

# ── Admin ─────────────────────────────────────
# Default super admin seed credentials (change immediately after first deploy)
SEED_ADMIN_EMAIL=admin@nextgenithub.in
SEED_ADMIN_PASSWORD=Change_Me_Immediately_123!

# ── GST / Business ────────────────────────────
SELLER_GSTIN=27AAAAA0000A1Z5
SELLER_STATE=Maharashtra
INVOICE_PREFIX=NGH
COMPANY_PAN=AAAAA0000A

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ── Feature Flags ─────────────────────────────
NEXT_PUBLIC_ENABLE_VIDEO_MEETINGS=true
NEXT_PUBLIC_ENABLE_WHATSAPP=true
NEXT_PUBLIC_ENABLE_BULK_ENQUIRY=true
NEXT_PUBLIC_ENABLE_BLOG=true
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# ── CORS ──────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://nextgenithub.in,https://www.nextgenithub.in

# ── Log Level ─────────────────────────────────
LOG_LEVEL=debug
